{
  "name": "@dev.smartpricing/traceflow-sdk",
  "version": "2.8.0",
  "description": "Node.js tracing and audit logs, plus Traceflow Error Monitoring for browser and React Native apps",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "bin",
    "ERROR_MONITORING.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:package": "node scripts/test-package.mjs",
    "test:release": "node --test scripts/release-version.check.mjs",
    "typecheck": "tsc --noEmit",
    "release": "commit-and-tag-version",
    "test:errors": "vitest run src/__tests__/errors.test.ts",
    "typecheck:errors": "tsc -p tsconfig.errors.json",
    "build:errors": "tsup --config tsup.errors.config.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smartpricing/traceflow-sdk.git",
    "directory": "js"
  },
  "keywords": [
    "tracing",
    "distributed-tracing",
    "monitoring",
    "observability",
    "kafka",
    "http",
    "async",
    "traces",
    "steps",
    "logs",
    "audit-log",
    "error-monitoring",
    "react-native"
  ],
  "author": "Andrei Borcea",
  "license": "ISC",
  "dependencies": {
    "uuid": "^13.0.0"
  },
  "peerDependencies": {
    "@confluentinc/kafka-javascript": "^1.6.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@confluentinc/kafka-javascript": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@confluentinc/kafka-javascript": "1.11.0",
    "@types/node": "^20.10.0",
    "@types/react": "^19.3.0",
    "@types/uuid": "^9.0.7",
    "commit-and-tag-version": "^12.7.3",
    "react": "18.3.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "brace-expansion": "^5.0.8"
  },
  "typesVersions": {
    "*": {
      "browser": [
        "./dist/browser.d.ts"
      ],
      "react-native": [
        "./dist/react-native.d.ts"
      ],
      "nuxt": [
        "./dist/nuxt.d.ts"
      ],
      "react": [
        "./dist/react.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.mjs",
      "require": "./dist/browser.js"
    },
    "./react-native": {
      "types": "./dist/react-native.d.ts",
      "import": "./dist/react-native.mjs",
      "require": "./dist/react-native.js"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.ts",
      "import": "./dist/nuxt.mjs",
      "require": "./dist/nuxt.js"
    },
    "./package.json": "./package.json",
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.mjs",
      "require": "./dist/react.js"
    }
  },
  "bin": {
    "traceflow-upload-map": "bin/traceflow-upload-map.mjs"
  }
}
