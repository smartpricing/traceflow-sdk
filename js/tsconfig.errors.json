{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/errors/**/*.ts", "src/browser.ts", "src/nuxt.ts", "src/react-native.ts", "src/react.ts", "src/__tests__/errors.test.ts"]
}
